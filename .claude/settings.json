{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/update-skills.sh >/dev/null 2>&1 || true",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/setup-editor.sh >/dev/null 2>&1 || true",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python -m editor.pipeline.doctor --quiet 2>/dev/null || true",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "tail -n 45 \"$CLAUDE_PROJECT_DIR\"/MEMORY.md 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "tail -n 45 \"$CLAUDE_PROJECT_DIR\"/MEMORY.md 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
