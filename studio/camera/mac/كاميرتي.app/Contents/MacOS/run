#!/bin/bash
# تطبيق «كاميرتي» للماك: يقرا كارت الكاميرا (Sony ZV-E10 II) ويجهّزه وحده، بنوافذ وأزرار عربية (بلا Terminal).
# - يحط الفلاتر السبعة بالمكان الي الكاميرا تدوّر بيه (PRIVATE/SONY/PRO/LUT)
# - يحفظ ملف إعدادات الكاميرا (الي تسويه الكاميرا بـ Save/Load Settings) بالماك، ويرجّعه للكارت وقت الحاجة
# ملاحظة: ملف الإعدادات تصنعه الكاميرا بس (صيغة سوني مقفولة)، فلازم تحفظه منها مرة وحدة.
# يشتغل على bash 3.2 وosascript (موجودين بكل ماك).

APP="$(cd "$(dirname "$0")/.." && pwd)"
LUTS="$APP/Resources/luts"
VOLUMES="${VOLUMES_DIR:-/Volumes}"
STORE="${BACKUP_DIR:-$HOME/Documents/كاميرتي}"
SAVED="$STORE/إعداداتي"
TITLE="كاميرتي"

q() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
msg() { osascript -e "display dialog \"$(q "$1")\" buttons {\"تمام\"} default button 1 with title \"$TITLE\"" >/dev/null 2>&1; }
ask() {  # ask "النص" "زر1" "زر2" ["زر3"]  -> يطبع الزر المختار
  local t="$1" d="\"$(q "$2")\"" b="\"$(q "$2")\""; shift 2
  for x in "$@"; do b="\"$(q "$x")\", $b"; done
  osascript -e "button returned of (display dialog \"$(q "$t")\" buttons {$b} default button $d with title \"$TITLE\")" 2>/dev/null
}

# ---- الكارت ----
find_cards() {
  for v in "$VOLUMES"/*; do
    [ -d "$v" ] || continue
    case "$(basename "$v")" in "Macintosh HD"*|Recovery|Preboot|VM|Data) continue ;; esac
    if [ -d "$v/DCIM" ] || [ -d "$v/PRIVATE" ]; then echo "$v"; fi
  done
}
CARD="$(find_cards | head -n 1)"
if [ "$(find_cards | wc -l | tr -d ' ')" -gt 1 ]; then
  list="$(find_cards | while read -r c; do printf '"%s", ' "$(q "$(basename "$c")")"; done | sed 's/, $//')"
  pick="$(osascript -e "choose from list {$list} with title \"$TITLE\" with prompt \"اكو أكثر من كارت. اختار كارت الكاميرا:\"" 2>/dev/null)"
  [ -n "$pick" ] && [ "$pick" != "false" ] && CARD="$VOLUMES/$pick"
fi
if [ -z "$CARD" ]; then
  msg "ما لگيت كارت الكاميرا.

دخّل الكارت بالماك (قارئ كارت) وافتحني من جديد.
الكارت لازم يكون انفرمت بالكاميرا مرة وحدة على الأقل."
  exit 0
fi

settings_on_card() {  # ملفات إعدادات سوني على الكارت (مو الفلاتر)
  [ -d "$CARD/PRIVATE/SONY" ] || return 0
  find "$CARD/PRIVATE/SONY" -type f \( -iname '*.dat' -o -iname '*.set' -o -iname '*.cfg' \) -not -path '*/PRO/LUT/*'
}

put_luts() {
  mkdir -p "$CARD/PRIVATE/SONY/PRO/LUT" || return 1
  cp -f "$LUTS"/[1-7].cube "$CARD/PRIVATE/SONY/PRO/LUT/" || return 1
}

save_settings() {  # من الكارت للماك (النسخة القديمة تنحفظ جنبها)
  local n=0 f rel
  [ -n "$(settings_on_card)" ] || return 1
  [ -d "$SAVED" ] && mv "$SAVED" "$STORE/نسخة-قديمة-$(date +%Y-%m-%d_%H-%M)"
  while IFS= read -r f; do
    rel="${f#"$CARD"/}"; mkdir -p "$SAVED/$(dirname "$rel")" && cp -p "$f" "$SAVED/$rel" && n=$((n+1))
  done < <(settings_on_card)
  echo "$n"
}

load_settings() {  # من الماك للكارت
  [ -d "$SAVED" ] || return 1
  (cd "$SAVED" && find . -type f) | while IFS= read -r f; do
    f="${f#./}"; mkdir -p "$CARD/$(dirname "$f")" && cp -p "$SAVED/$f" "$CARD/$f"
  done
}

eject() {
  sync
  if command -v diskutil >/dev/null 2>&1 && [ -z "$VOLUMES_DIR" ]; then diskutil eject "$CARD" >/dev/null 2>&1; fi
}

# ---- الشغل: كلشي تلقائي ----
name="$(basename "$CARD")"
if ! put_luts; then
  msg "ما گدرت أكتب على الكارت «$name».
يمكن قفل الحماية مسدود: الزر الصغير بجنب الكارت، حركه لفوگ."
  exit 0
fi
done_txt="✅ حطيت الفلاتر السبعة بالكارت."

on_card="$(settings_on_card)"
if [ -n "$on_card" ] && [ ! -d "$SAVED" ]; then
  n="$(save_settings)"
  done_txt="$done_txt
✅ لگيت إعدادات الكاميرا بالكارت، وحفظتها بالماك ($n ملف). من هسه أگدر أرجعها وقت ما تريد."
  next="بالكاميرا: دخّل الفلاتر (الخطوة 16 بالتطبيق)."
elif [ -n "$on_card" ] && [ -d "$SAVED" ]; then
  Q="$done_txt

الكارت بيه إعدادات كاميرا، وعندي نسخة محفوظة بالماك. شتريد؟"
  r="$(ask "$Q" "خلّي المحفوظة" "احفظ الي بالكارت بدالها")"
  if [ "$r" = "احفظ الي بالكارت بدالها" ]; then
    n="$(save_settings)"; done_txt="$done_txt
✅ حفظت إعدادات الكارت الجديدة بالماك ($n ملف). القديمة بقت نسخة احتياط."
  fi
  next="بالكاميرا: دخّل الفلاتر (الخطوة 16 بالتطبيق)."
elif [ -z "$on_card" ] && [ -d "$SAVED" ]; then
  load_settings
  done_txt="$done_txt
✅ رجّعت إعداداتك المحفوظة للكارت."
  next="بالكاميرا (طلّعها من MR قبل):
MENU > Setup > Reset/Save Settings > Save/Load Settings > Load
وكل الإعدادات ترجع بدوسة وحدة."
else
  next="ماكو إعدادات محفوظة بعد. مرة وحدة بس:
1) اضبط الكاميرا ويا التطبيق (22 خطوة).
2) بالكاميرا: MENU > Setup > Reset/Save Settings > Save/Load Settings > Save New
3) دخّل الكارت وافتحني، وأحفظها بالماك للأبد."
fi

eject
msg "$done_txt

$next

طلّعت الكارت، تگدر تسحبه."
